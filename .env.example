# Core API Configuration
PUMPPORTAL_API_KEY=ppk_your_api_key_here
MODE=lightning  # or 'local' for direct signing
PUBLIC_KEY=your_public_key_here
PRIVATE_KEY_B58=your_private_key_base58_here
RPC_URL=https://api.mainnet-beta.solana.com

# Trading Parameters
FIXED_BUY_SOL=0.002
SELL_PERCENT=100
MAX_SLIPPAGE_PCT=5
JITO_TIP_SOL=0.00005
POOL=auto

# Risk Management
MAX_CONCURRENT_POS=10
DAILY_SOL_BUDGET=0.1
MAX_POS_PCT=10
TP_PCT=5
SL_PCT=1
TRAIL_PCT=3
HOLD_SECS=1200
MIN_COIN_AGE_DAYS=10
DAILY_PROFIT_TARGET=0.0025

# Paper Trading (Recommended for testing)
DRY_RUN=true
VIRTUAL_BALANCE=0.33

# Watchlist (5-10 mints recommended)
WATCHLIST_MINTS=mint1,mint2,mint3,mint4,mint5

# Copy Trading (optional)
COPY_TRADE_CREATORS=creator1,creator2

# WebSocket & Data Sources
WS_ENABLE=true
WS_URL=wss://pumpportal.fun/api/data
METIS_URL=https://your-metis-endpoint.com

# Notifications
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Schedule (24h format)
SCHEDULE_START=18:00
SCHEDULE_END=18:20

# Advanced Features
ENABLE_MEV_PROTECTION=true
ENABLE_ADVANCED_RUG_DETECTION=true
MAX_HOLDER_CONCENTRATION_PCT=20
MIN_HOLDERS_COUNT=50
ENABLE_ML_SCORING=false
ML_MODEL_PATH=./models/token_scorer.pkl