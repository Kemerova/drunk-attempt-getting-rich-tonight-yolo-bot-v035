class MEVProtector:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.log = logging.getLogger("mev-protector")
        self.jito_client = None
        self.current_wallet_index = 0
        
        if JITO_AVAILABLE and cfg.enable_mev_protection:
            try:
                self.jito_client = JitoClient(cfg.jito_block_engine_url)
            except Exception as e:
                self.log.warning("Jito client init failed: %s", e)
    
    def get_next_wallet(self) -> Optional[str]:
        """Rotate through multiple wallets to avoid MEV targeting"""
        if not self.cfg.multi_wallet_keys:
            return self.cfg.private_key_b58
        
        key = self.cfg.multi_wallet_keys[self.current_wallet_index]
        self.current_wallet_index = (self.current_wallet_index + 1) % len(self.cfg.multi_wallet_keys)
        return key
    
    async def create_bundle_transaction(self, buy_tx: bytes, sell_tx: Optional[bytes] = None) -> Optional[str]:
        """Create atomic bundle for buy+sell to prevent MEV"""
        if not self.jito_client or not self.cfg.enable_mev_protection:
            return None
        
        try:
            bundle = Bundle()
            bundle.add_transaction(buy_tx)
            if sell_tx:
                bundle.add_transaction(sell_tx)
            
            result = await self.jito_client.send_bundle(bundle)
            return result.get("bundle_id")
            
        except Exception as e:
            self.log.warning("Bundle creation failed: %s", e)
            return None
    
    def calculate_optimal_tip(self, priority_level: str = "medium") -> float:
        """Calculate optimal Jito tip based on network conditions"""
        base_tips = {"low": 0.00001, "medium": 0.00005, "high": 0.0001}
        return base_tips.get(priority_level, self.cfg.jito_tip_sol)

