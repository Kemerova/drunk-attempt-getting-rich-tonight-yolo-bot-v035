class RugDetector:
    def __init__(self, session: ClientSession, cfg: Config):
        self.sess = session
        self.cfg = cfg
        self.log = logging.getLogger("rug-detector")
    
    async def analyze_holders(self, mint: str) -> Dict[str, Any]:
        """Analyze token holder distribution for rug risk"""
        if not self.cfg.enable_advanced_rug_detection:
            return {"risk_score": 0.0, "holders_count": 100}  # Default safe values
        
        try:
            payload = GetTokenLargestAccounts(mint).to_json()
            async with self.sess.post(self.cfg.rpc_url, json=json.loads(payload)) as r:
                js = await r.json()
                
                if "result" not in js or not js["result"].get("value"):
                    return {"risk_score": 1.0, "holders_count": 0, "reason": "no_holders_data"}
                
                accounts = js["result"]["value"]
                total_supply = sum(float(acc["amount"]) for acc in accounts)
                
                if not accounts:
                    return {"risk_score": 1.0, "holders_count": 0, "reason": "no_accounts"}
                
                # Calculate concentration risk
                largest_holder_pct = (float(accounts[0]["amount"]) / total_supply) * 100 if total_supply > 0 else 100
                top_5_pct = sum(float(acc["amount"]) for acc in accounts[:5]) / total_supply * 100 if total_supply > 0 else 100
                
                holders_count = len([acc for acc in accounts if float(acc["amount"]) > 0])
                
                risk_score = 0.0
                reasons = []
                
                # High concentration risk
                if largest_holder_pct > self.cfg.max_holder_concentration_pct:
                    risk_score += 0.4
                    reasons.append(f"largest_holder_{largest_holder_pct:.1f}%")
                
                if top_5_pct > 50:
                    risk_score += 0.3
                    reasons.append(f"top5_{top_5_pct:.1f}%")
                
                # Low holder count
                if holders_count < self.cfg.min_holders_count:
                    risk_score += 0.3
                    reasons.append(f"low_holders_{holders_count}")
                
                return {
                    "risk_score": min(risk_score, 1.0),
                    "holders_count": holders_count,
                    "largest_holder_pct": largest_holder_pct,
                    "top_5_pct": top_5_pct,
                    "reasons": reasons
                }
                
        except Exception as e:
            self.log.warning("Holder analysis failed for %s: %s", mint, e)
            return {"risk_score": 0.5, "holders_count": 0, "reason": "analysis_failed"}
    
    async def check_liquidity_locks(self, mint: str) -> Dict[str, Any]:
        """Check if liquidity is locked (simplified implementation)"""
        # This would require more complex analysis of the token's liquidity pool
        # For now, return a basic implementation
        return {"locked": False, "lock_duration": 0, "risk_score": 0.2}
    
    async def analyze_creator_history(self, creator: str) -> Dict[str, Any]:
        """Analyze creator's token creation history for patterns"""
        try:
            # Get recent transactions from creator
            config = RpcSignaturesForAddressConfig(limit=50)
            payload = GetSignaturesForAddress(creator, config).to_json()
            
            async with self.sess.post(self.cfg.rpc_url, json=json.loads(payload)) as r:
                js = await r.json()
                
                if "result" not in js:
                    return {"risk_score": 0.3, "reason": "no_history"}
                
