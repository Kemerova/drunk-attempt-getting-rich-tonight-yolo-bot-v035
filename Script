class Strategy:
    def __init__(self, cfg: Config, pp: PumpPortal, metis: Optional[Metis], pf: Portfolio, session: ClientSession):
        self.cfg, self.pp, self.metis, self.pf, self.sess = cfg, pp, metis, pf, session
        self.log = logging.getLogger("strategy")
        self.rug_detector = RugDetector(session, cfg)
        self.ml_scorer = MLTokenScorer(cfg)
    async def get_token_age(self, mint: str) -> Optional[float]:
        config = RpcSignaturesForAddressConfig(limit=1)
        payload = GetSignaturesForAddress(mint, config).to_json()
        try:
            async with self.sess.post(self.cfg.rpc_url, json=json.loads(payload)) as r:
                js = await r.json()
                if "result" in js and js["result"]:
                    sig = js["result"][0]["signature"]
                    tx_payload = GetTransaction(sig, {"encoding": "json", "maxSupportedTransactionVersion": 0}).to_json()
                    async with self.sess.post(self.cfg.rpc_url, json=json.loads(tx_payload)) as tx_r:
                        tx_js = await tx_r.json()
                        if "result" in tx_js and tx_js["result"].get("blockTime"):
                            return time.time() - tx_js["result"]["blockTime"]
        except Exception as e:
            log.warning("Age check failed: %s", e)
        return None
    async def token_score(self, mint: str, q: Dict[str, Any], age_days: float = 0) -> float:
        """Enhanced token scoring with ML and rug detection"""
        
        # Get rug detection analysis
        holder_analysis = await self.rug_detector.analyze_holders(mint)
        
        # Prepare data for ML scoring
        token_data = {
            "price_impact_pct": q.get("priceImpactPct", 100),
            "expected_output": q.get("expectedOutputAmount", 0),
            "age_days": age_days,
            "holders_count": holder_analysis.get("holders_count", 0),
            "largest_holder_pct": holder_analysis.get("largest_holder_pct", 100),
            "volume_24h": q.get("volume24h", 0),  # If available from quote
            "liquidity_usd": q.get("liquidityUsd", 0),  # If available from quote
        }
        
        # Get ML score
        ml_score = self.ml_scorer.predict_score(token_data)
        
        # Apply rug detection penalty
        rug_risk = holder_analysis.get("risk_score", 0)
        final_score = ml_score * (1 - rug_risk)
        
        self.log.info("Token %s: ML=%.3f, Rug Risk=%.3f, Final=%.3f", 
                     mint[:8], ml_score, rug_risk, final_score)
        
        return final_score
    async def should_enter(self, signal: Dict[str, Any]) -> bool:
        bal = await self.pp.get_balance()
        buy_size = min(self.cfg.fixed_buy_sol, bal * 0.01)  # Dynamic 1% risk
        if not self.pf.can_buy(buy_size, bal):
            return False
        if bal < buy_size + self.cfg.jito_tip_sol:
            return False
        mint = signal.get("mint")
        if not mint or mint not in self.cfg.watchlist_mints:
            return False
        age_secs = await self.get_token_age(mint)
        if age_secs is None or age_secs / 86400 < self.cfg.min_coin_age_days:
            log.info("Skip %s: Age %.1f days < %d", mint, age_secs / 86400 if age_secs else 0, self.cfg.min_coin_age_days)
            return False
        q = await self.metis.quote(mint, "BUY", buy_size, True) if self.metis else await fallback_quote(self.sess, mint, "BUY", buy_size, True)
        if not q or q.get("priceImpactPct", 100) > 10:
            log.info("Skip %s: High impact/rug risk", mint)
            return False
        age_days = age_secs / 86400 if age_secs else 0
        score = await self.token_score(mint, q, age_days)
        
        # Enhanced filtering with rug detection
        if score < 0.6:  # Lowered threshold due to rug risk penalty
            log.info("Skip %s: Low score %.3f", mint, score)
            return False
        
        # Additional creator analysis for copy trading
        creator_risk = 0.0
        if signal.get("creator") and self.cfg.enable_advanced_rug_detection:
            creator_analysis = await self.rug_detector.analyze_creator_history(signal["creator"])
            creator_risk = creator_analysis.get("risk_score", 0)
            if creator_risk > 0.5:
                log.info("Skip %s: High creator risk %.3f", mint, creator_risk)
                return False
        
        log_to_csv({
            "mint": mint, 
            "signal": json.dumps(signal), 
            "age_days": age_days, 
            "score": score,
            "creator_risk": creator_risk,
            "timestamp": time.time()
        })
        return True
    async def enter(self, mint: str) -> Optional[Position]:
        res = await self.pp.buy(mint, self.cfg.fixed_buy_sol)
        sig = res.get("signature") or ""
        qty = float(res.get("tokenAmount", 0))
        if qty <= 0 and self.metis:
            q = await self.metis.quote(mint, "BUY", self.cfg.fixed_buy_sol, True)
            qty = float(q.get("expectedOutputAmount", 0)) if q else 0.0
        pos = Position(mint=mint, buy_sig=sig, qty=qty, cost_sol=self.cfg.fixed_buy_sol, avg_price=self.cfg.fixed_buy_sol / max(qty, 1e-9))
        self.pf.add_position(mint, sig, qty, self.cfg.fixed_buy_sol)
        msg = f"ENTER {mint} sig={sig} qty={qty:.6f} cost={self.cfg.fixed_buy_sol:.6f} SOL"
        log.info(msg)
        asyncio.create_task(send_telegram_alert(self.cfg.telegram_bot_token, self.cfg.telegram_chat_id, msg))
        return pos
    async def exit_logic(self, pos: Position, mark_price: Optional[float]) -> Optional[str]:
        if mark_price and pos.avg_price > 0:
            change_pct = (mark_price / pos.avg_price - 1) * 100
            pos.high_watermark = max(pos.high_watermark, change_pct)
            log.info("%s PnL: %.1f%% (high: %.1f%%)", pos.mint, change_pct, pos.high_watermark)
            if change_pct >= self.cfg.tp_pct:
                return "tp"
            if change_pct <= -self.cfg.sl_pct:
                return "sl"
            trail = self.cfg.trail_pct if change_pct < 3 else self.cfg.trail_pct / 1.5
            if pos.high_watermark >= trail and change_pct <= (pos.high_watermark - trail):
                return "trail"
        if time.time() - pos.entry_ts >= self.cfg.hold_secs:
            return "time"
        return None
    async def exit(self, mint: str, reason: str, exit_sol: float = 0.0) -> Optional[str]:
        res = await self.pp.sell(mint, self.cfg.sell_percent)
        sig = res.get("signature") or ""
        self.pf.remove(mint, exit_sol)
        msg = f"EXIT {mint} reason={reason} sig={sig}"
        log.info(msg)
        asyncio.create_task(send_telegram_alert(self.cfg.telegram_bot_token, self.cfg.telegram_chat_id, msg))
        return sig
