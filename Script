async def health_monitor(session: ClientSession, cfg: Config):
    while True:
        try:
            async with session.get(cfg.rpc_url, timeout=5) as r:
                if r.status != 200:
                    log.warning("RPC failed")
            async with session.get("https://pumpportal.fun/api/ping", timeout=5) as r:
                if r.status != 200:
                    log.warning("PumpPortal failed")
            if cfg.ws_enable:
                async with session.ws_connect(cfg.ws_url, timeout=5) as ws:
                    await ws.close()
        except Exception as e:
            log.warning("Health failed: %s", e)
        await asyncio.sleep(60)
def in_schedule():
    now = datetime.now().time()
    start = dtime.fromisoformat(CFG.schedule_start)
    end = dtime.fromisoformat(CFG.schedule_end)
    return start <= now <= end
async def close_out_all(strat: Strategy, session: ClientSession):
    for mint, pos in list(strat.pf.positions.items()):
        price = await mark_price(strat.metis, session, mint, pos)
        exit_sol = price * pos.qty if price else 0.0
        await strat.exit(mint, "schedule_end", exit_sol)
    log.info("Closed all positions")
