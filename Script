@dataclass
class Position:
    mint: str
    buy_sig: str
    qty: float
    cost_sol: float
    avg_price: float
    entry_ts: float = field(default_factory=time.time)
    high_watermark: float = 0.0
class Portfolio:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.positions: Dict[str, Position] = {}
        self.daily_spent_sol: float = 0.0
        self.realized_pnl_sol: float = 0.0
        self.day_epoch = self._day_key()
        self.state_file = "portfolio.json"
        self._load_state()
    def _day_key(self):
        return time.strftime("%Y-%m-%d", time.gmtime())
    def rollover_if_needed(self):
        k = self._day_key()
        if k != self.day_epoch:
            self.day_epoch = k
            self.daily_spent_sol = 0.0
            self.realized_pnl_sol = 0.0
            asyncio.create_task(self._save_state())
    async def _save_state(self):
        state = {"daily_spent": self.daily_spent_sol, "day_epoch": self.day_epoch,
                 "realized_pnl": self.realized_pnl_sol, "positions": {k: vars(v) for k,v in self.positions.items()}}
        async with aiofiles.open(self.state_file, "w") as f:
            await f.write(json.dumps(state))
    def _load_state(self):
        if os.path.exists(self.state_file):
            with open(self.state_file, "r") as f:
                state = json.load(f)
                self.daily_spent_sol = state.get("daily_spent", 0.0)
                self.realized_pnl_sol = state.get("realized_pnl", 0.0)
                self.day_epoch = state.get("day_epoch", self._day_key())
                self.positions = {k: Position(**v) for k, v in state.get("positions", {}).items()}
    def can_buy(self, sol_size: float, balance: float) -> bool:
        self.rollover_if_needed()
        if len(self.positions) >= self.cfg.max_concurrent_pos:
            return False
        if self.daily_spent_sol + sol_size > self.cfg.daily_sol_budget:
            return False
        if sol_size > balance * self.cfg.max_pos_pct / 100:
            return False
        return True
    def add_position(self, mint: str, sig: str, qty: float, cost_sol: float):
        avg = cost_sol / max(qty, 1e-9)
        self.positions[mint] = Position(mint=mint, buy_sig=sig, qty=qty, cost_sol=cost_sol, avg_price=avg)
        self.daily_spent_sol += cost_sol
        asyncio.create_task(self._save_state())
    def remove(self, mint: str, exit_sol: float = 0.0):
        pos = self.positions.pop(mint, None)
        if pos:
            pnl = exit_sol - pos.cost_sol
            self.realized_pnl_sol += pnl
            log.info("PNL %s: %.6f SOL (total: %.6f)", mint, pnl, self.realized_pnl_sol)
            log_to_csv({"mint": mint, "pnl": pnl, "exit_sol": exit_sol, "ts": time.time()})
            if self.realized_pnl_sol >= self.cfg.daily_profit_target:
                log.info("Hit daily profit target %.6f! Selling everything.", self.cfg.daily_profit_target)
                # Trigger close-out (handled in main loop)
        asyncio.create_task(self._save_state())
