class MLTokenScorer:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.model = None
        self.scaler = None
        self.log = logging.getLogger("ml-scorer")
        
        if ML_AVAILABLE and cfg.enable_ml_scoring:
            self._load_model()
    
    def _load_model(self):
        """Load pre-trained ML model for token scoring"""
        try:
            if os.path.exists(self.cfg.ml_model_path):
                with open(self.cfg.ml_model_path, 'rb') as f:
                    model_data = pickle.load(f)
                    self.model = model_data['model']
                    self.scaler = model_data['scaler']
                self.log.info("ML model loaded successfully")
            else:
                self.log.info("No ML model found, will use rule-based scoring")
        except Exception as e:
            self.log.warning("Failed to load ML model: %s", e)
    
    def extract_features(self, token_data: Dict[str, Any]) -> np.ndarray:
        """Extract features for ML model"""
        features = [
            token_data.get("price_impact_pct", 0),
            token_data.get("expected_output", 0) / 1e6,  # Normalize
            token_data.get("age_days", 0),
            token_data.get("holders_count", 0) / 100,  # Normalize
            token_data.get("largest_holder_pct", 0),
            token_data.get("volume_24h", 0) / 1e6,  # Normalize
            token_data.get("liquidity_usd", 0) / 1e6,  # Normalize
        ]
        return np.array(features).reshape(1, -1)
    
    def predict_score(self, token_data: Dict[str, Any]) -> float:
        """Predict token score using ML model"""
        if not self.model or not ML_AVAILABLE:
            return self._rule_based_score(token_data)
        
        try:
            features = self.extract_features(token_data)
            if self.scaler:
                features = self.scaler.transform(features)
            
            # Get probability of positive outcome
            prob = self.model.predict_proba(features)[0][1]
            return float(prob)
            
        except Exception as e:
            self.log.warning("ML prediction failed: %s", e)
            return self._rule_based_score(token_data)
    
    def _rule_based_score(self, token_data: Dict[str, Any]) -> float:
        """Fallback rule-based scoring"""
        score = 0.0
        
        # Low price impact
        if token_data.get("price_impact_pct", 100) < 5:
            score += 0.3
        elif token_data.get("price_impact_pct", 100) < 10:
            score += 0.2
        
        # High expected output
        if token_data.get("expected_output", 0) > 1e6:
            score += 0.2
        
        # Age factor
        age_days = token_data.get("age_days", 0)
        if 1 <= age_days <= 30:
            score += 0.2
        elif age_days > 30:
            score += 0.1
        
        # Holder distribution
        if token_data.get("holders_count", 0) > 100:
            score += 0.2
        
        if token_data.get("largest_holder_pct", 100) < 15:
            score += 0.1
        
        return min(score, 1.0)
    
    def train_model(self, csv_file: str = "trades_metadata.csv"):
        """Train ML model on historical trade data"""
        if not ML_AVAILABLE:
            self.log.warning("ML libraries not available")
            return
        
        try:
            if not os.path.exists(csv_file):
                self.log.warning("No training data found")
                return
            
            df = pd.read_csv(csv_file)
            if len(df) < 50:
                self.log.warning("Insufficient training data")
                return
            
            # Prepare features and labels
            features = []
            labels = []
            
            for _, row in df.iterrows():
                if pd.notna(row.get('pnl')) and pd.notna(row.get('score')):
                    features.append([
                        row.get('score', 0),
                        row.get('age_days', 0),
                        # Add more features as available
                    ])
                    labels.append(1 if row['pnl'] > 0 else 0)
            
            if len(features) < 20:
                self.log.warning("Insufficient valid training samples")
                return
            
            X = np.array(features)
            y = np.array(labels)
            
            # Train model
            self.scaler = StandardScaler()
            X_scaled = self.scaler.fit_transform(X)
            
            self.model = LogisticRegression(random_state=42)
            self.model.fit(X_scaled, y)
            
            # Save model
            os.makedirs(os.path.dirname(self.cfg.ml_model_path), exist_ok=True)
            with open(self.cfg.ml_model_path, 'wb') as f:
                pickle.dump({'model': self.model, 'scaler': self.scaler}, f)
            
            self.log.info("ML model trained and saved successfully")
            
        except Exception as e:
            self.log.error("Model training failed: %s", e)

