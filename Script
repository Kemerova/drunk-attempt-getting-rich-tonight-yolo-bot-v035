class PumpPortal:
    def __init__(self, session: ClientSession, cfg: Config):
        self.sess = session
        self.cfg = cfg
        self.base_trade = "https://pumpportal.fun/api/trade"
        self.base_local = "https://pumpportal.fun/api/trade-local"
        self.headers = {"Content-Type": "application/json"}
        self.sim_balance = cfg.virtual_balance if cfg.dry_run else None
        self.sim_positions = {} if cfg.dry_run else None
        self.mev_protector = MEVProtector(cfg)
    async def get_balance(self) -> float:
        if self.cfg.dry_run:
            return self.sim_balance
        if self.cfg.mode == "lightning":
            log.warning("Lightning balance check not implemented; assuming sufficient")
            return math.inf
        else:
            payload = GetBalance(self.cfg.public_key).to_json()
            async with self.sess.post(self.cfg.rpc_url, json=payload) as r:
                js = await r.json()
                return js["result"]["value"] / 1e9 if "result" in js else 0.0
    async def buy(self, mint: str, amount_sol: float) -> Dict[str, Any]:
        if self.cfg.dry_run:
            self.sim_balance -= amount_sol
            sim_qty = amount_sol * random.uniform(900000, 1100000)  # Simulated tokens
            log.info("PAPER BUY %s for %.6f SOL (qty: %.6f, bal: %.6f)", mint, amount_sol, sim_qty, self.sim_balance)
            return {"signature": "paper_sig", "tokenAmount": sim_qty}
        payload = {
            "action": "buy",
            "mint": mint,
            "amount": amount_sol,
            "denominatedInSol": "true",
            "slippage": self.cfg.max_slippage_pct,
            "priorityFee": self.cfg.jito_tip_sol,
            "pool": self.cfg.pool,
        }
        if self.cfg.mode == "lightning":
            url = f"{self.base_trade}?api-key={self.cfg.api_key}"
            return await retry_op(self._post_json, url, payload)
        else:
            payload["publicKey"] = self.cfg.public_key
            raw = await retry_op(self._post_bytes, self.base_local, payload)
            sig = await retry_op(self._sign_and_send, raw)
            return {"signature": sig, "mode": "local"}
    async def sell(self, mint: str, percent: str | float = "100%") -> Dict[str, Any]:
        if self.cfg.dry_run:
            # Simulate sell with random PNL
            sim_pnl = random.uniform(-0.01, 0.10) * self.cfg.fixed_buy_sol  # -1% to +10%
            self.sim_balance += self.cfg.fixed_buy_sol + sim_pnl
            log.info("PAPER SELL %s (PNL: %.6f, bal: %.6f)", mint, sim_pnl, self.sim_balance)
            return {"signature": "paper_sig"}
        payload = {
            "action": "sell",
            "mint": mint,
            "amount": str(percent),
            "denominatedInSol": "false",
            "slippage": self.cfg.max_slippage_pct,
            "priorityFee": self.cfg.jito_tip_sol,
            "pool": self.cfg.pool,
        }
        if self.cfg.mode == "lightning":
            url = f"{self.base_trade}?api-key={self.cfg.api_key}"
            return await retry_op(self._post_json, url, payload)
        else:
            payload["publicKey"] = self.cfg.public_key
            raw = await retry_op(self._post_bytes, self.base_local, payload)
            sig = await retry_op(self._sign_and_send, raw)
            return {"signature": sig, "mode": "local"}
    async def _post_json(self, url: str, payload: Dict[str, Any]) -> Dict[str, Any]:
        async with self.sess.post(url, headers=self.headers, json=payload, timeout=ClientTimeout(total=30)) as r:
            txt = await r.text()
            if r.status >= 400:
                raise RuntimeError(txt)
            return json.loads(txt)
    async def _post_bytes(self, url: str, payload: Dict[str, Any]) -> bytes:
        async with self.sess.post(url, headers=self.headers, json=payload, timeout=ClientTimeout(total=30)) as r:
            raw = await r.read()
            if r.status >= 400:
                raise RuntimeError(raw.decode())
            return raw
    async def _sign_and_send(self, raw_tx: bytes, extra_signers: Optional[List[Keypair]] = None, use_mev_protection: bool = True) -> str:
        if Keypair is None:
            raise RuntimeError("solders required for local")
        
        # Use wallet rotation for MEV protection
        wallet_key = self.mev_protector.get_next_wallet() if use_mev_protection else self.cfg.private_key_b58
        secret_bytes = b58decode(wallet_key)
        kp = Keypair.from_bytes(secret_bytes)
        
        tx = VersionedTransaction.deserialize(raw_tx)
        signers = [kp] + (extra_signers or [])
        tx.sign(signers)
        
        # Try Jito bundle first if MEV protection is enabled
        if use_mev_protection and self.mev_protector.jito_client:
            try:
                bundle_id = await self.mev_protector.create_bundle_transaction(raw_tx)
                if bundle_id:
                    log.info("Transaction sent via Jito bundle: %s", bundle_id)
                    return bundle_id
            except Exception as e:
                log.warning("Jito bundle failed, falling back to regular tx: %s", e)
        
        # Fallback to regular transaction
        cfg = RpcSendTransactionConfig(preflight_commitment=CommitmentLevel.Confirmed)
        payload = SendVersionedTransaction(tx, cfg).to_json()
        async with self.sess.post(self.cfg.rpc_url, json=json.loads(payload), timeout=ClientTimeout(total=30)) as r:
            js = await r.json()
            if "result" in js:
                await self._confirm_tx(js["result"])
                return js["result"]
            raise RuntimeError(str(js))
    async def _confirm_tx(self, sig: str):
        for _ in range(10):
            payload = {"jsonrpc": "2.0", "id": 1, "method": "getSignatureStatuses", "params": [[sig]]}
            async with self.sess.post(self.cfg.rpc_url, json=payload) as r:
                js = await r.json()
                status = js.get("result", {}).get("value", [{}])[0].get("confirmationStatus")
                if status in ["confirmed", "finalized"]:
                    return
            await asyncio.sleep(0.5)
        log.warning("Tx %s not confirmed", sig)
