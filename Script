class Metis:
    def __init__(self, session: ClientSession, base_url: str):
        self.sess = session
        self.base = base_url.rstrip("/")
    async def quote(self, mint: str, side: str, amount: float, denom_sol: bool = True) -> Optional[Dict[str, Any]]:
        params = {"mint": mint, "type": side.upper(), "amount": amount, "denominatedInSol": str(denom_sol).lower()}
        url = f"{self.base}/pump-fun/quote"
        try:
            async with self.sess.get(url, params=params, timeout=ClientTimeout(10)) as r:
                if r.status == 200:
                    return await r.json()
        except Exception as e:
            log.debug("Metis error: %s", e)
        return None
async def fallback_quote(session: ClientSession, mint: str, side: str, amount: float, denom_sol: bool) -> Optional[Dict[str, Any]]:
    url = "https://quote-api.jup.ag/v6/quote"
    input_mint = "So11111111111111111111111111111111111111112" if denom_sol and side == "BUY" else mint
    output_mint = mint if denom_sol and side == "BUY" else "So11111111111111111111111111111111111111112"
    params = {
        "inputMint": input_mint,
        "outputMint": output_mint,
        "amount": int(amount * 1e9) if denom_sol else int(amount),
        "slippageBps": int(CFG.max_slippage_pct * 100),
    }
    try:
        async with session.get(url, params=params) as r:
            if r.status == 200:
                js = await r.json()
                return {"expectedOutputAmount": js.get("outAmount", 0), "priceImpactPct": js.get("priceImpactPct", 0)}
    except Exception as e:
        log.debug("Jupiter error: %s", e)
    return None
