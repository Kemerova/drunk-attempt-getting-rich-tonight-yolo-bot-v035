class Backoff:
    def __init__(self, base=0.5, cap=8.0):
        self.base, self.cap, self.attempts = base, cap, 0
    def sleep(self):
        t = min(self.cap, self.base * (2 ** self.attempts)) + random.random() * 0.25
        self.attempts += 1
        return t
    def reset(self):
        self.attempts = 0
async def retry_op(fn, *args, max_retries=5, **kwargs):
    backoff = Backoff()
    for attempt in range(max_retries):
        try:
            return await fn(*args, **kwargs)
        except Exception as e:
            if attempt == max_retries - 1:
                raise
            t = backoff.sleep()
            log.warning(f"Retry {attempt+1}/{max_retries} in {t:.2f}s: {e}")
            await asyncio.sleep(t)
async def send_telegram_alert(bot_token: str, chat_id: str, message: str):
