# Main Orchestrator
# ------------------------------
async def trader():
    timeout = ClientTimeout(total=30)
    async with aiohttp.ClientSession(timeout=timeout) as session:
        pp = PumpPortal(session, CFG)
        metis = Metis(session, CFG.metis_url) if CFG.metis_url else None
        pf = Portfolio(CFG)
        strat = Strategy(CFG, pp, metis, pf, session)
        sig_q: asyncio.Queue = asyncio.Queue()
        
        # Train ML model if enabled and sufficient data exists
        if CFG.enable_ml_scoring and ML_AVAILABLE:
            log.info("Training ML model on historical data...")
            strat.ml_scorer.train_model()
        
        tasks = [
            asyncio.create_task(ws_signal_loop(CFG, sig_q)),
            asyncio.create_task(board_scan_loop(session, CFG, sig_q)),
            asyncio.create_task(health_monitor(session, CFG)),
        ]
        try:
            while True:
                if not in_schedule():
                    await close_out_all(strat, session)
                    await asyncio.sleep(60)
                    continue
                # Kohrs-style: Check if target hit, close all
                if pf.realized_pnl_sol >= CFG.daily_profit_target:
                    await close_out_all(strat, session)
                    log.info("Pausing until next day after profit target.")
                    await asyncio.sleep(86400 - (time.time() % 86400))  # Sleep to next day
                    pf.realized_pnl_sol = 0.0  # Reset
                    continue
                try:
                    signal = await asyncio.wait_for(sig_q.get(), timeout=1)
                    if await strat.should_enter(signal):
                        pos = await strat.enter(signal["mint"])
                        if pos:
                            poll_sec = 1  # Tighter for quick trades
                            while signal["mint"] in pf.positions and in_schedule():
                                price = await mark_price(metis, session, signal["mint"], pos)
                                reason = await strat.exit_logic(pos, price)
                                if reason:
                                    exit_sol = price * pos.qty if price else 0.0
                                    await strat.exit(signal["mint"], reason, exit_sol)
                                    break
                                if price and pos.avg_price > 0:
                                    change = (price / pos.avg_price - 1) * 100
                                    poll_sec = 0.5 if abs(change) > 3 else 1
                                await asyncio.sleep(poll_sec)
                except asyncio.TimeoutError:
                    pass
        finally:
            for t in tasks:
                t.cancel()
