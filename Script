async def ws_signal_loop(cfg: Config, q: asyncio.Queue):
    if not cfg.ws_enable:
        return
    backoff = Backoff()
    while True:
        try:
            async with aiohttp.ClientSession() as sess:
                async with sess.ws_connect(cfg.ws_url, heartbeat=20) as ws:
                    backoff.reset()
                    async for msg in ws:
                        if msg.type == WSMsgType.TEXT:
                            data = json.loads(msg.data)
                            if data.get("type") == "token_created" and data.get("mint") in cfg.watchlist_mints:
                                await q.put(data)
        except Exception as e:
            t = backoff.sleep()
            await asyncio.sleep(t)
